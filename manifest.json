{
  "manifest_version": 3,
  "name": "Webtoons Dark Mode",
  "description": "Dark mode for webtoons.com on desktop. Comic images are left untouched.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["*://*.webtoons.com/*"],
      "css": ["dark.css"],
      "js": ["dark.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
